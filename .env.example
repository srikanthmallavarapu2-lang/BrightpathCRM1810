# ==============================================================================
# BrightPath CRM — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in this directory and replace with your real project keys.
# NEVER commit your real '.env' file or service-role keys to Git!
# Retrieve your keys from: Supabase Dashboard -> Project Settings -> API

# Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Client Key
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
